{
  "_about": {
    "what": "Super Octo Giggle team to-do board. index.html reads this file. Settings first, then tasks. Every id below is a lowercase key; show people and projects by their 'name'.",
    "statuses": "Board columns in order. 'Review' means waiting on someone (see task.reviewer). 'Done' means finished (see task.doneDate).",
    "projects": "id: key used by task.project. name: display name. color: hex for charts. archived: true if hidden from pickers.",
    "people": "Core team. id: key used by task.owner, task.with, task.reviewer and checklist.who. name: display initials.",
    "guests": "Reviewers outside the core team (e.g. QAQC). Same id/name shape as people. They can appear in with, reviewer and checklist.who but never as owner.",
    "task": {
      "id": "Unique id, '<owner>-<suffix>'.",
      "owner": "Person id responsible for the task (from people).",
      "project": "Project id (from projects).",
      "title": "Short description.",
      "status": "One of statuses.",
      "start": "YYYY-MM-DD the work starts, or null.",
      "due": "YYYY-MM-DD it's due, or null.",
      "doneDate": "YYYY-MM-DD it was moved to Done, or null if not done.",
      "reviewer": "Ball in court: list of person or guest ids who must act. Only filled while status is 'Review', otherwise [].",
      "with": "Other person or guest ids helping on the task.",
      "notes": "Free text, what exactly needs to be done.",
      "checklist": "Subtasks: { text, done (true/false), who (list of person or guest ids), doneDate (YYYY-MM-DD when checked off, or null) }."
    },
    "rules": "No time tracking. Progress = checklist items done / total. Overdue = due is before today and status is not Done. Unknown ids in with/who are free-typed names; show them as-is."
  },
